# ─── Bitbucket Source ─────────────────────────────────────────────────────────
# Your Bitbucket Cloud workspace slug (visible in your workspace URL)
BITBUCKET_WORKSPACE=my-workspace

# Your Bitbucket username (not email address)
BITBUCKET_USERNAME=my-username

# Bitbucket App Password (Personal settings → App passwords)
# Required scopes: Account (read), Workspace membership (read),
#                  Projects (read), Repositories (read), Pull requests (read),
#                  Pipelines (read)
BITBUCKET_APP_PASSWORD=ATBB-xxxxxxxxxxxxxxxxxxxx

# ─── Backup Settings ──────────────────────────────────────────────────────────
# Local directory where backup snapshots will be stored
BACKUP_DIR=./backups

# Number of parallel workers for repository backup (keep ≤ 4 to avoid rate limits)
BACKUP_WORKERS=4

# ─── GitLab Restore Target ────────────────────────────────────────────────────
RESTORE_GITLAB_URL=https://gitlab.com
RESTORE_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Top-level GitLab group path where the workspace content will be restored
RESTORE_TARGET_GROUP=my-restored-group
